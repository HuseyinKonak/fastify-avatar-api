PORT=8083
HOST=0.0.0.0
SERVICE_NAME=avatar
TRUST_PROXY=false
NODE_ENV=development
LOG_LEVEL=debug
REDIS_URL=redis://redis:6379
CORS_ORIGINS=http://localhost:3000

# Production metrics are disabled unless explicitly enabled. Use a random value
# of at least 24 characters when ENABLE_METRICS=true in production.
ENABLE_METRICS=false
# METRICS_TOKEN=replace-with-a-long-random-token

# Default avatar settings
DEFAULT_WIDTH=128
DEFAULT_HEIGHT=128
DEFAULT_FONT_FAMILY=Arial
DEFAULT_FORMAT=png
DEFAULT_SHAPE=circle
DEFAULT_MODE=short

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Cache settings
CACHE_MAX_ITEMS=500
CACHE_MAX_SIZE_MB=50
CACHE_TTL_MS=3600000

# Batch settings
MAX_BATCH_SIZE=50
BATCH_CONCURRENCY=10
