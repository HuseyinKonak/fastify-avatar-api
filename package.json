{
  "name": "fastify-avatar-service",
  "version": "1.1.0",
  "description": "Avatar generation microservice built with Fastify, Sharp, and Redis",
  "license": "MIT",
  "keywords": [
    "avatar",
    "fastify",
    "sharp",
    "redis",
    "typescript"
  ],
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/etag": "^6.2.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/under-pressure": "^9.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.9.3",
    "lru-cache": "^11.5.3",
    "pino": "^9.6.0",
    "piscina": "^5.3.2",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "uuid": "^13.0.0",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
