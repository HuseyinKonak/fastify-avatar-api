{
  "name": "fastify-avatar-service",
  "version": "1.1.0",
  "description": "Avatar generation microservice built with Fastify, Sharp, and Redis",
  "license": "MIT",
  "keywords": [
    "avatar",
    "fastify",
    "sharp",
    "redis",
    "typescript"
  ],
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/etag": "^6.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/under-pressure": "^9.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.0.2",
    "pino": "^9.6.0",
    "piscina": "^5.1.4",
    "prom-client": "^15.1.3",
    "sharp": "^0.33.5",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
